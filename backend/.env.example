# Google Gemini API Key for NexusData / CityPulse AI Insights
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
OPENAQ_API_KEY=
WAQI_TOKEN=
DATA_GOV_IN_KEY=
DATA_GOV_IN_RESOURCE_ID=
NEXUSDATA_DB_PATH=storage/nexusdata.sqlite
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LIVE_HTTP_TIMEOUT_SECONDS=8
LOG_LEVEL=INFO
# Optional JSON: DEVELOPMENT_WEIGHTS={"air":0.35,"heat":0.25,"density":0.20,"load":0.20}
